--- a/tests/authoring_storage.rs
+++ b/tests/authoring_storage.rs
@@ -0,0 +1,13 @@
+use msi::{Package, PackageType};
+use std::io::Cursor;
+
+#[test]
+fn created_installer_uses_native_compatible_v3_compound_storage() {
+    let mut package = Package::create(PackageType::Installer, Cursor::new(Vec::new())).unwrap();
+    package.flush().unwrap();
+    let bytes = package.into_inner().unwrap().into_inner();
+    assert_eq!(u16::from_le_bytes([bytes[26], bytes[27]]), 3);
+    assert_eq!(u16::from_le_bytes([bytes[30], bytes[31]]), 9);
+    let reopened = Package::open(Cursor::new(bytes)).unwrap();
+    assert_eq!(reopened.package_type(), PackageType::Installer);
+}
